.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test output files
*.pdf
*.docx
*.xlsx
*.pptx
*.eml
output/
test-output/
temp/
tmp/

# API testing artifacts
api-test/output/
api-test/temp/
api-test/*.log

# Environment and config files
.env
.env.local
.env.*.local
*.env

# Debug files
debug/
*.log
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Backup files
*.bak
*.backup
*.old

# Python artifacts (if any Python scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/

# Node.js (if any JS tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation build
docs/_build/
docs/.doctrees/

# Coverage reports
*.lcov
coverage/
*.coverage
.coverage.*

# Temporary files
*.tmp
*.temp
.cache/

# Binary executables (except examples)
*.exe
*.dll
*.so
*.dylib

# Keep example outputs in version control
!examples/**/*.pdf
!examples/**/*.docx
!examples/**/*.xlsx
!examples/**/*.pptx

# C++ SDK build artifacts
cpp-sdk/build/
cpp-sdk/cmake-build-*/
cpp-sdk/*.o
cpp-sdk/*.a
cpp-sdk/*.so